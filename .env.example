# Stellar Network Configuration
# Opciones: testnet, mainnet, futurenet
STELLAR_NETWORK=testnet

# Admin Wallet Configuration (Wallet maestra que administra el contrato)
ADMIN_SECRET_KEY=S...
ADMIN_PUBLIC_KEY=G...

# Contract Configuration
CONTRACT_ID=C...

# Stellar RPC Configuration
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Para deployment
SOURCE_ACCOUNT_NAME=admin

# Opcional: Friendbot para testnet (genera fondos automáticamente)
USE_FRIENDBOT=true

# Logging
DEBUG=true
